#!/bin/bash

# Copyright 2026 Google LLC

# Google Cloud Project ID
PROJECT_ID="your-google-cloud-project-id"

# Cloud Run Service Name
SERVICE_NAME="genesys-chat-adapter"

# Cloud Run Service Account
SERVICE_ACCOUNT="your-service-account@${PROJECT_ID}.iam.gserviceaccount.com"

# Regions to deploy to
REGIONS=("us-central1" "europe-west1")

# Resources
CPU="1"
MEMORY="512Mi"

# Genesys API Key Secret (GSM path or literal value)
# e.g., "projects/your-project-id/secrets/genesys-api-key/versions/latest"
# or "your-actual-api-key"
GENESYS_API_KEY_SECRET="projects/your-project-id/secrets/genesys-api-key/versions/latest"

# Firestore Collection for session tracking
# Strongly recommended: without it, session state is per-instance only and
# breaks as soon as Cloud Run scales beyond one container.
FIRESTORE_SESSIONS_COLLECTION="genesys-chat-sessions"

# Debug mode (true/false)
# Logs full request bodies (including customer utterances) and, unless
# CES_EXCLUDE_DIAGNOSTIC_INFO is set explicitly, stops suppressing CES
# diagnosticInfo. Leave false in production.
DEBUG="false"

# Total budget for the CES call, in seconds. Must stay below the Genesys webhook
# deadline so the adapter can still return a graceful handoff rather than being
# abandoned mid-request. Genesys does not publish that deadline, so the 7.0
# default is a conservative guess. CES server-side work dominates this budget
# (measured p50 up to 4.5s in slower deployments), so do not lower it without
# checking your own CES latency.
CES_TIMEOUT_SECONDS="7.0"

# Ask CES to omit diagnosticInfo (~97% of the response body).
# Defaults to the inverse of DEBUG.
CES_EXCLUDE_DIAGNOSTIC_INFO="true"

# Ngrok domain for local testing (optional)
NGROK_DOMAIN="your-ngrok-domain.ngrok-free.app"
